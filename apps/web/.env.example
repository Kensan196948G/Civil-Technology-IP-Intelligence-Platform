# .env.example — 変数名と安全な例のみ。実値をコミットしないこと。

# Neon PostgreSQL 接続文字列（実値は管理者から受領し .env.local に設定する）
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# デモ認証Cookieの署名鍵（本番相当の秘匿性が必要になった時点でCloudflare Secretsへ移行）
CTIIP_DEMO_COOKIE_SECRET=replace-with-a-random-64-char-string

# db:seed 実行時の安全確認（破壊的操作のため既定では拒否される）
CTIIP_ALLOW_SEED_TRUNCATE=true
CTIIP_SEED_ALLOWED_HOST=your-mvp-project.aws.neon.tech
CTIIP_SEED_ALLOWED_DB=neondb
