# .env.example — 変数名と安全な例のみ。実値をコミットしないこと。
# 実際の設定は apps/web/.env.local（.gitignore 対象）に置く。

# ── データベース ──────────────────────────────────────────────
# 主DBは ローカルPostgreSQL（2026-08-29 に Neon から移行済み）。
# 詳細: docs/20-architecture/adr/ADR-0007-local-postgresql.md
# 接続先例（ホスト上の PostgreSQL 16 / 127.0.0.1:5432）:
#
# ⚠️ 開発者は **開発用DB `civil_tech_ip_intelligence_dev`** を使うこと。
#    `civil_tech_ip_intelligence` は**本番DB**であり、`db:seed` は全業務テーブルを
#    TRUNCATE するため、誤って指定すると**本番データを失う**（残存リスク）。
DATABASE_URL=postgresql://ctip_app:CHANGE_ME@127.0.0.1:5432/civil_tech_ip_intelligence_dev

# ── 認証 ──────────────────────────────────────────────────────
# デモ認証Cookieの署名鍵（必須。未設定だと起動時ではなくログイン試行時にエラーになる）
CTIIP_DEMO_COOKIE_SECRET=replace-with-a-random-64-char-string

# 実デプロイ環境（HTTPS 配下）でのみ true にする。
# ローカル/CIのHTTP環境では未設定のままにする（secureなCookieはHTTPSでのみ有効なため）。
CTIIP_COOKIE_SECURE=false

# ── db:seed 実行時の安全確認（破壊的操作のため既定では拒否される）──
CTIIP_ALLOW_SEED_TRUNCATE=true
# seed を実行してよい接続先を「ホスト名・DB名の完全一致」で指定する（fail closed）
CTIIP_SEED_ALLOWED_HOST=127.0.0.1
CTIIP_SEED_ALLOWED_DB=civil_tech_ip_intelligence_dev

# ── AI（Anthropic Claude API）連携 ──────────────────────────────
# FR-M06-002 Claim分解などで使用。未設定の場合は決定論的なモックへ自動フォールバックし、
# 実APIは呼ばれない（本番APIキー未発行の間の既定動作）。実値はコミットしないこと。
ANTHROPIC_API_KEY=
# 既定は claude-sonnet-5。上書きする場合のみ設定する。
ANTHROPIC_MODEL=claude-sonnet-5

# ── 意味検索（pgvector, ADR-0003）用の埋め込みAPI（Voyage AI）連携 ──────────
# /api/search の③意味検索レイヤーおよび db:seed の embedding 列投入で使用。
# 未設定の場合は意味検索レイヤーを無効化する（RRF融合には①構造検索・②字句検索[pg_trgm]の
# みが寄与し、既存の /api/search の挙動は変わらない。本番APIキー未発行の間の既定動作）。
# 実値はコミットしないこと。
VOYAGE_API_KEY=
# 既定は voyage-4-lite（最も安価）。より高精度が必要な場合のみ voyage-4 / voyage-4-large 等に上書きする。
VOYAGE_MODEL=voyage-4-lite
