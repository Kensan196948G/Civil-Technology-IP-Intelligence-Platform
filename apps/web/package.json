{
  "name": "@ctiip/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf:build": "npx @cloudflare/next-on-pages@1.13.16",
    "cf:deploy": "wrangler pages deploy .vercel/output/static --project-name=ctiip-mvp",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:seed": "tsx src/lib/db/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "0.10.1",
    "drizzle-orm": "0.45.2",
    "next": "15.5.25",
    "postgres": "3.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.13.16",
    "@playwright/test": "1.55.1",
    "@types/node": "20.14.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.24.2",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "3.2.7",
    "wrangler": "3.114.17"
  },
  "pnpm": {}
}
